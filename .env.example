MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=artly
NEO4J_URI=neo4j+s://INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=INSTANCE_ID
NEO4J_PASSWORD=PASSWORD
# Base64 of at least 32 random bytes
JWT_SECRET=BASE64_SECRET
# Chat: base64 of the Firebase service-account key JSON (Firebase console > Project settings > Service accounts).
# Leave empty to run without chat (/chat/** then answers 503).
FIREBASE_SERVICE_ACCOUNT_B64=
# Calls: the Agora project's App ID and App Certificate (Agora console > Project > Config), 32 hex characters each.
# The certificate is a secret. Leave either one empty to run without calls (/chat/call/** then answers 503).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
